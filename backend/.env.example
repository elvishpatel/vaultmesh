# ============================================
# VaultMesh Environment Configuration
# ============================================
# Copy this file to .env and fill in your real local values.

# Server
PORT=5000
NODE_ENV=development

# JWT Secret - generate a strong random string
JWT_SECRET=dummy-jwt-secret-change-me

# Supabase
SUPABASE_URL=https://dummy-project.supabase.co
SUPABASE_ANON_KEY=dummy-supabase-anon-key
SUPABASE_SERVICE_KEY=dummy-supabase-service-key
SUPABASE_STORAGE_BUCKET=vaultmesh-chunks

# Encryption
MASTER_ENCRYPTION_KEY=dummy-32-byte-hex-encryption-key

# Storage Nodes
NODE_A_PATH=./storage/node1
NODE_B_PATH=./storage/node2

# File Limits
MAX_FILE_SIZE_MB=50
CHUNK_SIZE_MB=4
